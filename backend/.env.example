# Django — en production, DEBUG=False et toutes les valeurs doivent être
# injectées par le gestionnaire de secrets de l’hébergeur, jamais commitées.
DEBUG=True
SECRET_KEY=change-moi-en-production-avec-une-cle-aleatoire-de-32-caracteres-minimum
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon (PostgreSQL) — copie la "Connection string" depuis le dashboard Neon
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/qrregister?sslmode=require

# Google OAuth — Google Cloud Console > Credentials > OAuth Client ID (type "Web application")
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Connexion Facebook / Apple (facultatif : un fournisseur sans clés est simplement désactivé).
# Procédure complète : docs/GUIDE_CONNEXION_FACEBOOK_APPLE.md
# Facebook — Meta for Developers > ton app > Paramètres > Général
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v25.0
# Apple — developer.apple.com > Identifiers (Services ID), Keys (.p8), Membership (Team ID)
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenu du fichier .p8 sur UNE ligne, retours à la ligne remplacés par \n
APPLE_PRIVATE_KEY=

# Frontend (en production : l'URL PUBLIQUE Vercel exacte, c'est elle qui sert d'URL de retour OAuth)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Administration plateforme : définir ces valeurs dans Render, jamais dans Git.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-20-characters

# Cloudinary — secrets à définir dans Render, jamais dans Git.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Staging/production : remplacer par les domaines HTTPS exacts.
# ALLOWED_HOSTS=api.example.com
# FRONTEND_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com

# Sécurité / exploitation (facultatif)
# Nombre de proxys de confiance devant l'API (Vercel + Render = 2) : lecture de l'IP réelle pour les limiteurs de débit.
# NUM_PROXIES=2
# Documentation OpenAPI (/api/docs/) : désactivée hors DEBUG. À n'activer que ponctuellement.
# EXPOSE_API_DOCS=false
# Chemin de l'admin Django (vide = non monté). L'administration réelle est l'espace /admin du frontend.
# DJANGO_ADMIN_URL=admin/
# Plafond (octets) d'un corps de requête API — 24 Mo par défaut (photos de pièces d'identité en base64).
# API_MAX_BODY_BYTES=25165824

# --- Plans et abonnements (apps/billing) ---------------------------------------------------------------------------
# Les plans ne verrouillent RIEN tant que PLAN_ENFORCEMENT_STARTS_AT est vide. En attendant, PLAN_OBSERVE_MODE=true journalise ce qui
# SERAIT bloqué (action d'audit « plan.would_block », visible dans le journal d'administration) sans rien bloquer.
# PLAN_ENFORCEMENT_STARTS_AT=2026-12-01T00:00:00+00:00
# PLAN_OBSERVE_MODE=true
# PLAN_TRIAL_DAYS=14
# Conservation (jours) : visites, fiches clients (après la dernière activité), journaux d'audit. Paiements : 10 ans, jamais purgés.
# RETENTION_VISITS_DAYS=365
# RETENTION_CLIENTS_DAYS=730
# RETENTION_AUDIT_DAYS=365
# Phrase « hébergement » de la mention d'information visiteur : à ajuster avec le dossier ARTCI.
# PRIVACY_TRANSFER_NOTE=Le service est hébergé par des prestataires techniques qui peuvent être situés hors de Côte d’Ivoire.
# Version des conditions d'utilisation acceptées par les comptes (changez-la pour redemander l'acceptation).
# TERMS_VERSION=cgu-2026-11
