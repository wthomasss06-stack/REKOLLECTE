# Django — en production, DEBUG=False et toutes les valeurs doivent être
# injectées par le gestionnaire de secrets de l’hébergeur, jamais commitées.
DEBUG=True
SECRET_KEY=change-moi-en-production-avec-une-cle-aleatoire-de-32-caracteres-minimum
ALLOWED_HOSTS=localhost,127.0.0.1

# Neon (PostgreSQL) — copie la "Connection string" depuis le dashboard Neon
DATABASE_URL=postgresql://user:password@ep-xxxx.eu-central-1.aws.neon.tech/qrregister?sslmode=require

# Google OAuth — Google Cloud Console > Credentials > OAuth Client ID (type "Web application")
GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com

# Connexion Facebook / Apple (facultatif : un fournisseur sans clés est simplement désactivé).
# Procédure complète : docs/GUIDE_CONNEXION_FACEBOOK_APPLE.md
# Facebook — Meta for Developers > ton app > Paramètres > Général
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
# FACEBOOK_GRAPH_VERSION=v25.0
# Apple — developer.apple.com > Identifiers (Services ID), Keys (.p8), Membership (Team ID)
APPLE_SERVICES_ID=
APPLE_TEAM_ID=
APPLE_KEY_ID=
# Contenu du fichier .p8 sur UNE ligne, retours à la ligne remplacés par \n
APPLE_PRIVATE_KEY=

# Frontend (en production : l'URL PUBLIQUE Vercel exacte, c'est elle qui sert d'URL de retour OAuth)
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000

# Administration plateforme : définir ces valeurs dans Render, jamais dans Git.
PLATFORM_ADMIN_EMAIL=admin@example.com
PLATFORM_ADMIN_PASSWORD=replace-with-a-random-password-of-at-least-20-characters

# Cloudinary — secrets à définir dans Render, jamais dans Git.
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Staging/production : remplacer par les domaines HTTPS exacts.
# ALLOWED_HOSTS=api.example.com
# FRONTEND_URL=https://app.example.com
# CORS_ALLOWED_ORIGINS=https://app.example.com
# CSRF_TRUSTED_ORIGINS=https://app.example.com
