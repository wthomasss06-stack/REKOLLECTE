NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_GOOGLE_CLIENT_ID=xxxxxxxxxxxx.apps.googleusercontent.com
# Méthodes de connexion affichées : google (défaut), facebook, apple. À activer APRÈS avoir configuré
# les clés côté backend (voir docs/GUIDE_CONNEXION_FACEBOOK_APPLE.md). Variable lue au build : redéployer après changement.
NEXT_PUBLIC_AUTH_PROVIDERS=google
